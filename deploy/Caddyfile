{$APP_DOMAIN} {
  encode zstd gzip

  header {
    Content-Security-Policy "default-src 'self'; base-uri 'none'; connect-src 'self' wss://{$APP_DOMAIN}; font-src 'none'; form-action 'self'; frame-ancestors 'none'; img-src 'self' data:; manifest-src 'self'; object-src 'none'; script-src 'self' 'sha256-MQAFCSh2LAe+xVXYQyyrknd6KTkTi71+u+6uN83qGMA='; style-src 'self' 'unsafe-inline'; worker-src 'self'; upgrade-insecure-requests"
    Permissions-Policy "camera=(), geolocation=(), microphone=(), payment=(), usb=()"
    Referrer-Policy "no-referrer"
    Strict-Transport-Security "max-age=31536000"
    X-Content-Type-Options "nosniff"
    X-Frame-Options "DENY"
  }

  @app_version path /app-version.json
  header @app_version Cache-Control "no-store"

  @service_worker path /sw.js
  header @service_worker Cache-Control "no-cache"

  @entry_html path /
  header @entry_html Cache-Control "no-cache, must-revalidate"

  @immutable path_regexp immutable ^/assets/.*-[A-Za-z0-9_-]+\.(css|js)$
  header @immutable Cache-Control "public, max-age=31536000, immutable"

  reverse_proxy server:3000
}
