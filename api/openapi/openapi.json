          "200": {
            "description": "Registered agent"
          }
        }
      }
    },
    "/api/v1/auth/csrf": {
      "get": {
        "responses": {
          "200": {
            "description": "CSRF token"
          }
        }
      }
    },
    "/api/v1/auth/login": {
      "post": {
        "responses": {
          "200": {
            "description": "Authenticated"
          }
        }
      }
    },
    "/api/v1/auth/register": {
      "post": {
        "responses": {
          "200": {
            "description": "Registered user"
          }
        }
      }
    },
    "/api/v1/commands": {
      "post": {
        "responses": {
          "200": {
            "description": "Created command batch"
          }
        }
      }
    },
    "/api/v1/devices": {
      "get": {
        "responses": {
          "200": {
            "description": "Owned devices"
          }
        }
      }
    },
    "/api/v1/enrollment-tokens": {
      "post": {
        "responses": {
          "200": {
            "description": "Created enrollment token"
          }
        }
      }
    },
    "/api/v1/meta/version": {
      "get": {
        "responses": {
          "200": {
            "description": "Version metadata"
          }
        }
      }
    },
    "/api/v1/setup/status": {
      "get": {
        "responses": {
          "200": {
            "description": "Setup status"
          }
        }
      }
    },
    "/api/v1/setup/test-data-service": {
      "post": {
        "responses": {
          "200": {
            "description": "Data service test result"
          }
        }
