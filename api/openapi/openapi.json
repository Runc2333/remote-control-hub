    "version": "1.0.0"
  },
  "paths": {
    "/api/v1/admin/registration": {
      "get": {
        "responses": {
          "200": {
            "description": "Registration policy"
          }
        }
      },
      "put": {
        "responses": {
          "200": {
            "description": "Updated registration policy"
          }
        }
      }
    },
    "/api/v1/admin/users": {
