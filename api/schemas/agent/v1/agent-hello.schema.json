{
  "type": "object",
  "required": [
    "messageSequence",
    "protocolVersion",
    "capabilities",
    "deviceId",
    "serviceVersion",
    "sessionVersion",
    "type"
  ],
  "properties": {
    "messageSequence": {
      "type": "integer",
      "minimum": 0
    },
    "protocolVersion": {
      "type": "number",
      "const": 1
    },
    "capabilities": {
      "type": "array",
      "items": {
        "anyOf": [
          {
            "type": "string",
            "const": "display.turn_off"
          },
          {
            "type": "string",
            "const": "media.volume_up"
          },
          {
            "type": "string",
            "const": "media.volume_down"
          },
          {
            "type": "string",
            "const": "media.volume_mute_toggle"
          },
          {
            "type": "string",
            "const": "media.play_pause"
          },
          {
            "type": "string",
            "const": "media.previous_track"
          },
          {
            "type": "string",
            "const": "media.next_track"
          },
          {
            "type": "string",
            "const": "media.stop"
          }
        ]
      },
      "uniqueItems": true
    },
    "deviceId": {
      "type": "string",
      "format": "uuid"
    },
    "serviceVersion": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "sessionVersion": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "type": {
      "type": "string",
      "const": "agent.hello"
    }
  },
  "additionalProperties": false
}
